<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================
    内容布局 — 模拟赛车驾驶舱 (美化版)
    所有控件ID与MainActivity.cs保持兼容
    ================================================================ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0E"
    android:padding="8dp">

    <!-- ========== 隐藏的旧控件 — 保持兼容 ========== -->
    <TextView android:id="@+id/textView1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/ThrottleButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/BrakeButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/ClutchButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSet" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSrd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSru" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ========== 顶部状态栏 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/round_rect_bg">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SIM COCKPIT"
            android:textColor="#FF4FC3F7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
        <EditText
            android:id="@+id/IPText1"
            android:layout_width="130dp"
            android:layout_height="26dp"
            android:inputType="text"
            android:text="192.168.1.100:8088"
            android:textColor="#FF8A9CA8"
            android:textSize="10sp"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+id/Connect"
            android:layout_width="50dp"
            android:layout_height="26dp"
            android:text="连接"
            android:textColor="#E0E0E0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/btn_accent"
            android:paddingHorizontal="0dp" />
        <Button
            android:id="@+id/btnNetMode"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:text="TCP"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark_small"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />
        <TextView
            android:id="@+id/textView_Ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555D65"
            android:textSize="9sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="5dp"
        android:background="#18222B" />

    <!-- ========== 中间主体三列布局 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- ===== 左栏 — 踏板控制区 ===== -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="1dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="油门"
                    android:textColor="#FF4CAF50"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvThrottleVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FF4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/gaugeThrottle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="1dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="刹车"
                    android:textColor="#FFF44336"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvBrakeVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFF44336"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/gaugeBrake"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="1dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="离合"
                    android:textColor="#FFAB47BC"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvClutchVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FFAB47BC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/gaugeClutch"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:background="#15222C" />

        <!-- ===== 中间 — 方向盘 (居中放大) ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 数据文字 -->
            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A=0 B=0 T=0 C=0 HB=OFF"
                android:textColor="#99808890"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <!-- 方向盘 FrameLayout 容器 (代码中add SteeringWheelView到这里) -->
            <FrameLayout
                android:id="@+id/steeringWheelContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="4dp" />

            <!-- 底部状态指示 + 控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="6dp">
                    <Button
                        android:id="@+id/btnClearAngle"
                        android:layout_width="100dp"
                        android:layout_height="30dp"
                        android:text="归零角度"
                        android:textColor="#FF80DEEA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_accent"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="方向盘: "
                            android:textColor="#8878909C"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />
                        <Switch
                            android:id="@+id/SteerEnableSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="← L"
                        android:textColor="#2A4555"
                        android:textSize="9sp"
                        android:layout_marginEnd="10dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CENTER"
                        android:textColor="#2A3845"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R →"
                        android:textColor="#2A4555"
                        android:textSize="9sp"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:background="#15222C" />

        <!-- ===== 右栏 — 档位 + 手刹 ===== -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="档位"
                android:textColor="#FF4FC3F7"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <Button
                android:id="@+id/btnGearUp"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="升档"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp"
                android:background="@drawable/btn_dark" />

            <Button
                android:id="@+id/btnGearDown"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="降档"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"
                android:background="@drawable/btn_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="#15222C" />

            <ToggleButton
                android:id="@+id/HandbrakeSwitch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textOff="手刹 关"
                android:textOn="手刹 开"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_dark"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
