<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0288D1" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF4FC3F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF01579B" android:endColor="#FF002F6C" android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF0277BD" />
        </shape>
    </item>
</selector>
