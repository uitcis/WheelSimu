<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF8E24AA" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFCE93D8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF7B1FA2" android:endColor="#FF4A148C" android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FF9C27B0" />
        </shape>
    </item>
</selector>
