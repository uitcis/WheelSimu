<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3D4F5F" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF546E7A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF263238" android:endColor="#FF1A2327" android:angle="270" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF37474F" />
        </shape>
    </item>
</selector>
