<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF43A047" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FF81C784" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF2E7D32" android:endColor="#FF1B5E20" android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FF388E3C" />
        </shape>
    </item>
</selector>
