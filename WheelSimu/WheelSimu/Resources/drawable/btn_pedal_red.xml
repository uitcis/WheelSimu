<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE53935" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFEF9A9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FFC62828" android:endColor="#FF8E0000" android:angle="270" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FFD32F2F" />
        </shape>
    </item>
</selector>
